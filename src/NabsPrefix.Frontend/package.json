{
  "name": "nabs-ui-react-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:ts && vite build",
    "build:ts": "tsc -b --checkers 8 --builders 4",
    "build:ts:ci": "tsc -b --checkers 2 --builders 1",
    "typecheck": "tsc -b --checkers 8 --builders 4",
    "typecheck:watch": "tsc -b --watch --checkers 8 --builders 4",
    "typecheck:single": "tsc -b --singleThreaded",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:structure": "vitest run tests/architecture",
    "test:behavior": "vitest run tests/behavior --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headless": "playwright test --project=chromium",
    "test:e2e:headed": "playwright test --headed --project=chromium",
    "test:e2e:visual": "playwright test tests/ui/visual.spec.ts --project=chromium",
    "test:e2e:visual:update": "playwright test tests/ui/visual.spec.ts --project=chromium --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "test:install:browsers": "playwright install",
    "test:all": "pnpm run test:unit && pnpm run test:e2e:headless"
  },
  "dependencies": {
    "@net-advantage/nabs-ui-shell": "^0.58.0",
    "@net-advantage/nabs-ui-themes": "^0.58.0",
    "@net-advantage/nabs-ui-themes-dark": "^0.58.0",
    "@net-advantage/nabs-ui-themes-light": "^0.58.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "oxlint": "^1.76.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
