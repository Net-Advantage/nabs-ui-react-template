{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "common",
    "ClientId": "<<Add to secrets.json>>",
    "ClientSecret": "<<Add to secrets.json>>",
    "CallbackPath": "/signin-oidc",
    "RedirectUri": "https://localhost:7007/signin-oidc"
  },
  "ReverseProxy": {
    "Routes": {
      "apiRoute": {
        "ClusterId": "apiCluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ]
      },
      "securePortalRoute": {
        "ClusterId": "securePortalCluster",
        "Match": {
          "Path": "/portals/secure/{**catch-all}"
        },
        "AuthorizationPolicy": "UiPolicy"
      },
      "portalRoute": {
        "ClusterId": "portalCluster",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "apiCluster": {
        "Destinations": {
          "Destination1": {
            "Address": "https+http://api-service"
          }
        }
      },
      "securePortalCluster": {
        "Destinations": {
          "Destination1": {
            "Address": "https+http://secure-portal-service"
          }
        }
      },
      "portalCluster": {
        "Destinations": {
          "Destination1": {
            "Address": "https+http://portal-service"
          }
        }
      }
    }
  }
}
